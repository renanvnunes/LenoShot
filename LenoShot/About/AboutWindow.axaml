<c:ChromeWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:c="using:LenoShot.Controls"
                x:Class="LenoShot.About.AboutWindow"
                Title="Sobre"
                Width="440" Height="640" MinWidth="400" MinHeight="460"
                WindowStartupLocation="CenterScreen"
                ShowMaximizeButton="False">
  <c:ChromeWindow.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#2C2C2E" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Grid.row">
      <Setter Property="Margin" Value="14,10" />
    </Style>
    <Style Selector="TextBlock.key">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="#8E8E93" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="#F5F5F7" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Rectangle.sep">
      <Setter Property="Height" Value="1" />
      <Setter Property="Fill" Value="#14FFFFFF" />
      <Setter Property="Margin" Value="14,0,0,0" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#8E8E93" />
      <Setter Property="Margin" Value="12,0,0,6" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="#2C2C2E" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="Margin" Value="0,0,6,6" />
    </Style>
    <Style Selector="Border.chip TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#D1D1D6" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="#8E96FF" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#B4B9FF" />
    </Style>
  </c:ChromeWindow.Styles>

  <ScrollViewer>
    <StackPanel Margin="24,4,24,24" Spacing="20">

      <!-- Identidade -->
      <StackPanel HorizontalAlignment="Center" Spacing="4" Margin="0,8,0,0">
        <Image x:Name="AppIconImage" Width="88" Height="88" HorizontalAlignment="Center" Margin="0,0,0,10" />
        <TextBlock Text="Leno Shot" FontSize="22" FontWeight="Normal" Foreground="#F5F5F7" HorizontalAlignment="Center" />
        <TextBlock x:Name="VersionText" FontSize="13" Foreground="#8E8E93" HorizontalAlignment="Center" />
        <TextBlock Text="Captura de tela minimalista para Linux e Windows" FontSize="13" Foreground="#AEAEB2"
                   HorizontalAlignment="Center" Margin="0,6,0,0" />
      </StackPanel>

      <!-- Informações -->
      <Border Classes="card">
        <StackPanel>
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <TextBlock Classes="key" Text="Criador" />
            <TextBlock Grid.Column="1" Classes="value" Text="Renan Nunes" />
          </Grid>
          <Rectangle Classes="sep" />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <TextBlock Classes="key" Text="Versão" />
            <TextBlock Grid.Column="1" Classes="value" x:Name="VersionValue" />
          </Grid>
          <Rectangle Classes="sep" />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <TextBlock Classes="key" Text="Licença" />
            <Button Grid.Column="1" Classes="link" x:Name="LicenseButton" Content="MIT · ver texto" />
          </Grid>
          <Border x:Name="LicensePanel" IsVisible="False" Margin="14,0,14,12" Padding="12,10"
                  Background="#1C1C1E" CornerRadius="8" MaxHeight="220">
            <ScrollViewer>
              <SelectableTextBlock x:Name="LicenseText" FontSize="11.5" Foreground="#AEAEB2"
                                   TextWrapping="Wrap" LineHeight="17" />
            </ScrollViewer>
          </Border>
          <Rectangle Classes="sep" />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <TextBlock Classes="key" Text="Código-fonte" />
            <Button Grid.Column="1" Classes="link" x:Name="GitHubLink" Content="GitHub" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Tecnologias -->
      <StackPanel>
        <TextBlock Classes="section" Text="TECNOLOGIAS" />
        <WrapPanel x:Name="TechPanel" />
      </StackPanel>

      <Button x:Name="GitHubButton" Classes="pill primary" HorizontalAlignment="Center" Padding="16,7">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Width="15" Height="15" Stretch="Uniform" Fill="White"
                Data="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8 0 3.2.9.8 1.3 1.9 1.3 3.2 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1 .9 2.2v3.3c0 .3.1.7.8.6A12 12 0 0 0 12 .3" />
          <TextBlock Text="Ver no GitHub" FontWeight="Normal" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <TextBlock x:Name="CopyrightText" FontSize="11.5" Foreground="#636366" HorizontalAlignment="Center" />
    </StackPanel>
  </ScrollViewer>
</c:ChromeWindow>
