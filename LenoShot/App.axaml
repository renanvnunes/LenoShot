<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LenoShot.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://LenoShot/Styles/ChromeWindow.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <!-- Cor inicial; a escolhida pelo usuário é aplicada pelo AccentTheme -->
        <ColorPaletteResources x:Key="Dark" Accent="#6E7BFF" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://LenoShot/Styles/Theme.axaml" />
  </Application.Styles>
</Application>
