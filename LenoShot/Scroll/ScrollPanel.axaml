<local:FloatingWindow xmlns="https://github.com/avaloniaui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:local="using:LenoShot.Scroll"
                      xmlns:ov="using:LenoShot.Overlay"
                      x:Class="LenoShot.Scroll.ScrollPanel"
                      Title="Leno Shot — rolagem"
                      Background="Transparent"
                      TransparencyLevelHint="Transparent"
                      ShowActivated="False">
  <Border Classes="toolbar" Margin="0" Padding="12,6,6,6" BoxShadow="none">
    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
      <Ellipse x:Name="Pulse" Width="9" Height="9" Fill="#FF453A" VerticalAlignment="Center" Margin="0,0,10,0">
        <Ellipse.Styles>
          <Style Selector="Ellipse">
            <Style.Animations>
              <Animation Duration="0:0:1.2" IterationCount="Infinite" PlaybackDirection="Alternate">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
              </Animation>
            </Style.Animations>
          </Style>
        </Ellipse.Styles>
      </Ellipse>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
        <TextBlock x:Name="StatusText" Text="Rolando a página…" FontSize="13" FontWeight="Light" Foreground="#F5F5F7" />
        <TextBlock x:Name="DetailText" Text="Tire o mouse da área para pausar" FontSize="11" Foreground="#8E8E93" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0">
        <Button x:Name="CancelButton" Classes="pill" Content="Cancelar" />
        <Button x:Name="DoneButton" Classes="pill primary" Content="Concluir" />
      </StackPanel>
    </Grid>
  </Border>
</local:FloatingWindow>
