<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>LenoShot</AssemblyName>
    <RootNamespace>LenoShot</RootNamespace>
    <Version>0.6.0</Version>
    <Authors>Renan Nunes</Authors>
    <Copyright>© 2026 Renan Nunes</Copyright>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Ícone do .exe no Windows, gerado pelo próprio app (opção export-ico; ver Program.cs) -->
    <ApplicationIcon>../packaging/LenoShot.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Texto da licença embutido no app (tela Sobre) -->
    <EmbeddedResource Include="../LICENSE" LogicalName="LICENSE" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
  </ItemGroup>
</Project>
